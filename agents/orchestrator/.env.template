# Orchestrator Configuration

# Port to listen on
PORT=8000

# Agent discovery endpoints (comma-separated)
# For local testing
AGENT_ENDPOINTS=http://localhost:8080/.well-known/agent.json

# For Kubernetes
# AGENT_ENDPOINTS=http://travel-agent-service/.well-known/agent.json

# Azure Service Bus (optional, for async communication)
SERVICEBUS_NAMESPACE=multiagent-dev-servicebus.servicebus.windows.net

# Authentication
# Set to 'false' for local development (uses Azure CLI)
# Set to 'true' for AKS deployment (uses Workload Identity)
USE_MANAGED_IDENTITY=false

# API Authentication
# Shared API key required by non-public endpoints
# MULTIAGENT_API_KEY=<shared-api-key>

# Optional per-user API keys (JSON mapping api key -> user id).
# The matching user id becomes the identity used to scope async responses.
# USER_API_KEYS={"alice-key": "alice"}

# Credential sent to externally hosted agents (never the shared internal key)
# EXTERNAL_AGENT_API_KEY=<external-agent-api-key>

# Extra agent base URL prefixes trusted with MULTIAGENT_API_KEY (comma-separated)
# TRUSTED_AGENT_URL_PREFIXES=http://travel-agent-service
